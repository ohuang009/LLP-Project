{
  "schema_version": "1.0",
  "mode": "node_only",
  "ner": {
    "enabled": true,
    "required": true,
    "architecture": "predicate_first_scibert_candidates_v1",
    "minimum_narrative_page_ratio": 0.5,
    "trusted_channels": [
      "structural_metadata",
      "persistent_lexicon"
    ],
    "channels": [
      "structural_metadata",
      "persistent_lexicon",
      "persistent_lexicon_ambiguous",
      "scibert_svo_argument"
    ]
  },
  "grammatical_candidate_generation": {
    "enabled": true,
    "required": true,
    "parser": "spacy_dependency_parser",
    "parser_model": "en_core_web_sm",
    "strategy": "predicate_first_subject_object_arguments",
    "scibert_model": "allenai/scibert_scivocab_uncased",
    "typing_method": "candidate_phrase_to_ontology_definition_embedding_similarity",
    "typing_threshold": 0.25,
    "typing_min_margin": 0.015,
    "typing_top_k": 5,
    "preserve_complete_argument_phrases": true,
    "remove_articles_during_generation": true,
    "cleanup_policy": "remove_leading_a_an_the_and_terminal_punctuation_only"
  },
  "prior_node_matching": {
    "enabled": true,
    "sources": ["persistent_lexicon", "completed_run_canonical_entities"],
    "same_type_only": true,
    "maximum_candidates_per_node": 12,
    "automatic_mapping": "exact_deepseek_returned_prior_canonical_name"
  },
  "context": {
    "minimum_sentences": 2,
    "maximum_sentences": 3,
    "stay_within_paragraph": false,
    "target_sentence_required": true
  },
  "llm_node_judge": {
    "enabled": true,
    "required": false,
    "provider": "ollama",
    "model": "deepseek-r1:7b",
    "base_url": "http://127.0.0.1:11434",
    "temperature": 0,
    "seed": 42,
    "context_window": 32768,
    "maximum_context_window": 65536,
    "keep_alive": "30m",
    "batch_sentences": 4,
    "max_output_tokens": 4096,
    "timeout_seconds": 600,
    "maximum_retries": 2,
    "cache_responses": true,
    "rubric_path": "config/node_validity_rubric.json",
    "allow_llm_discovery": false,
    "allow_new_class_candidates": false,
    "invalid_output_policy": "review_and_audit"
  },
  "reference_resolution": {
    "maximum_previous_sentences": 2,
    "maximum_human_review_candidates": 5,
    "unresolved_policy": "ignore_and_audit"
  },
  "llm_reference_judge": {
    "enabled": true,
    "required": false,
    "provider": "ollama",
    "model": "deepseek-r1:7b",
    "base_url": "http://127.0.0.1:11434",
    "temperature": 0,
    "seed": 42,
    "context_window": 8192,
    "keep_alive": "30m",
    "batch_pairs": 4,
    "max_output_tokens": 4096,
    "timeout_seconds": 600,
    "maximum_retries": 2,
    "cache_responses": true,
    "same_confidence_threshold": 0.8,
    "unavailable_policy": "human_review"
  },
  "similarity": {
    "candidate_threshold": 0.64,
    "automatic_merge_policy": "exact_reviewed_aliases_only",
    "human_review_required_for_fuzzy_matches": true
  }
}
