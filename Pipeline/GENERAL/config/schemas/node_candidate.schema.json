{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node_candidate.schema.json",
  "title": "Node candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "document_id",
    "surface_text",
    "suggested_label",
    "candidate_generators",
    "source"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "surface_text": {"type": "string", "minLength": 1},
    "suggested_label": {"type": "string", "minLength": 1},
    "suggested_canonical_name": {"type": "string"},
    "candidate_generators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "confidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "evidence_quote"],
      "properties": {
        "kind": {"enum": ["document_metadata", "sentence_span"]},
        "sentence_id": {"type": "string"},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "quote": {"type": "string"},
        "evidence_quote": {"type": "string"}
      }
    }
  }
}
